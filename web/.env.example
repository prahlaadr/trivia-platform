# Trivia Platform — environment variables
# Copy to .env.local. ALL are optional for local development:
# `bun dev` runs every mode out of the box with none of these set.

# Gates quiz upload + delete. If unset, those actions are open locally.
ADMIN_PIN=

# Vercel Blob storage token — only needed for the DEPLOYED build (Vercel sets
# this automatically). Locally the app falls back to filesystem storage, so
# leave this blank for local dev.
BLOB_READ_WRITE_TOKEN=
